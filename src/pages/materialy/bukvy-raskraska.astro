---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { absolute, breadcrumbSchema } from '../../lib/schema';

const crumbs = [
  { name: 'Главная', path: '/' },
  { name: 'Для печати', path: '/materialy/' },
  { name: 'Буквы-раскраски', path: '/materialy/bukvy-raskraska/' },
];

const letters = ['А','Б','В','Г','Д','Е','Ё','Ж','З','И','Й','К','Л','М','Н','О','П','Р','С','Т','У','Ф','Х','Ц','Ч','Ш','Щ','Ъ','Ы','Ь','Э','Ю','Я'];

const schema = [
  { '@type': 'HowTo', name: 'Буквы-раскраски', url: absolute('/materialy/bukvy-raskraska/', Astro.site) },
  breadcrumbSchema(crumbs, Astro.site),
];
---

<BaseLayout
  title="Буквы-раскраски: все 33 буквы для печати"
  description="Распечатайте крупные контуры букв русского алфавита. Ребёнок раскрашивает, обводит пальцем и запоминает образ буквы."
  schema={schema}
>
  <div class="container page">
    <div class="no-print">
      <Breadcrumbs items={crumbs} />
      <h1>Буквы-раскраски</h1>
      <p>Называйте букву звуком: «м», а не «эм». Пока ребёнок красит, можно называть слова на этот звук: мак, мама, мыло.</p>
      <button class="button" type="button" onclick="window.print()">Распечатать</button>
    </div>
    <div class="letters">
      {letters.map((letter) => (
        <div class="letter">
          <span>{letter}</span>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page { padding: 28px 0 40px; }
  .letters {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 16px;
    margin-top: 24px;
  }
  .letter {
    aspect-ratio: 1;
    background: #fff;
    border: 2px solid #ead9c0;
    border-radius: 18px;
    display: grid;
    place-items: center;
  }
  .letter span {
    font-size: 7rem;
    font-weight: 900;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 3px #2b2d42;
  }
  @media print {
    .letters { grid-template-columns: repeat(3, 1fr); }
    .letter { break-inside: avoid; }
  }
</style>
