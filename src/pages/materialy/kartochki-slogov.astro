---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { absolute, breadcrumbSchema } from '../../lib/schema';

const crumbs = [
  { name: 'Главная', path: '/' },
  { name: 'Для печати', path: '/materialy/' },
  { name: 'Карточки слогов', path: '/materialy/kartochki-slogov/' },
];

const vowels = ['А', 'О', 'У', 'Ы', 'Э', 'Я', 'Ё', 'Ю', 'И', 'Е'];
const consonants = ['М', 'Н', 'Л', 'Р', 'С', 'П', 'Т', 'К'];
const groups = consonants.map((consonant) => ({
  consonant,
  syllables: vowels.map((vowel) => consonant + vowel.toLowerCase()),
}));

const schema = [
  { '@type': 'HowTo', name: 'Карточки слогов для печати', url: absolute('/materialy/kartochki-slogov/', Astro.site) },
  breadcrumbSchema(crumbs, Astro.site),
];
---

<BaseLayout
  title="Карточки слогов для печати"
  description="Распечатайте карточки слогов с М, Н, Л, Р, С, П, Т и К. Играйте в лото, составляйте слова, учите читать по слогам дома."
  schema={schema}
>
  <div class="container page">
    <div class="no-print">
      <Breadcrumbs items={crumbs} />
      <h1>Карточки слогов</h1>
      <p>Распечатайте лист, разрежьте по пунктиру. Сначала берите слоги с одной согласной, например только с М. Потом смешивайте.</p>
      <button class="button" type="button" onclick="window.print()">Распечатать</button>
    </div>
    {groups.map((group) => (
      <section class="group">
        <h2 class="no-print">Слоги с {group.consonant}</h2>
        <div class="cards">
          {group.syllables.map((syllable) => <div class="card-item">{syllable}</div>)}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .page { padding: 28px 0 40px; }
  .cards {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0;
    margin: 18px 0 32px;
  }
  .card-item {
    border: 1px dashed #c9b89a;
    min-height: 110px;
    display: grid;
    place-items: center;
    font-weight: 900;
    font-size: 2rem;
    background: #fff;
  }
  @media print {
    .cards { grid-template-columns: repeat(5, 1fr); }
    .card-item { min-height: 90px; }
  }
</style>
