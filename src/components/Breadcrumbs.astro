---
interface Props {
  items: { name: string; path: string }[];
}

const { items } = Astro.props;
---

<nav class="crumbs no-print" aria-label="Навигация">
  <ol>
    {items.map((item, index) => (
      <li>
        {index < items.length - 1 ? <a href={item.path}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0 0 18px;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .crumbs li:not(:last-child)::after {
    content: '›';
    margin-left: 6px;
    color: var(--ink-soft);
  }
  .crumbs a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--orange);
  }
</style>
